@model IEnumerable<TanfeethIntegration.Models.ApplicationUser>

@{
    ViewData["Title"] = "قائمة المستخدمين";
}

<div class="dashboard-head"><div><h2>@ViewData["Title"]</h2><p>إدارة حسابات المستخدمين وصلاحيات الوصول إلى المنصة.</p></div></div>

<div class="text-center mb-4">
    <a asp-action="Register" class="btn btn-success btn-lg">
        <i class="fas fa-user-plus"></i> إضافة مستخدم جديد
    </a>
</div>

<div class="dashboard-card"><div class="table-responsive">
    <table class="table table-striped table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>الاسم الكامل</th>
                <th>اسم المستخدم</th>
                <th>تاريخ الإنشاء</th>
                <th>آخر تحديث</th>
                <th>نشط</th>
                <th>مدير نظام</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.UserName</td>
                    <td>@user.CreationDate.ToString("yyyy-MM-dd")</td>
                    <td>@user.LastUpdate.ToString("yyyy-MM-dd")</td>
                    <td>@(user.IsActive ? "نعم" : "لا")</td>
                    <td>@(user.IsAdmin ? "نعم" : "لا")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary">تعديل</a>
                        <button type="button" class="btn btn-sm btn-warning" onclick="confirmToggle('@user.Id', '@user.IsActive')">
                            @(user.IsActive ? "تعطيل" : "تفعيل")
                        </button>
                        <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post" id="toggle-form-@user.Id" style="display:none">
                        </form>
                        <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete('@user.Id')">حذف</button>
                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" id="delete-form-@user.Id" style="display:none">
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div></div>


<script>
    function confirmToggle(userId, isActive) {
        var actionText = isActive === "True" ? "تعطيل" : "تفعيل";
        var actionConfirm = isActive === "True" ? "تعطيل" : "تفعيل";

        swal({
            title: "هل أنت متأكد؟",
            text: "هل تريد " + actionText + " هذا المستخدم؟",
            icon: "warning",
            buttons: ["إلغاء", actionConfirm],
            dangerMode: true,
        }).then((willToggle) => {
            if (willToggle) {
                document.getElementById('toggle-form-' + userId).submit();
            }
        });
    }

    function confirmDelete(userId) {
        swal({
            title: "هل أنت متأكد؟",
            text: "هل تريد حذف هذا المستخدم؟",
            icon: "warning",
            buttons: ["إلغاء", "حذف"],
            dangerMode: true,
        }).then((willDelete) => {
            if (willDelete) {
                document.getElementById('delete-form-' + userId).submit();
            }
        });
    }
</script>

<style>
    .table {
        border-radius: 5px;
        overflow: hidden;
    }

        .table thead {
            background-color: #343a40;
            color: #fff;
        }

        .table th, .table td {
            vertical-align: middle;
            text-align: center;
        }

    .btn-sm {
        margin: 0 2px;
    }

    .table-responsive {
        margin-top: 20px;
    }

    .text-center .btn-lg {
        margin-bottom: 20px;
    }
</style>
