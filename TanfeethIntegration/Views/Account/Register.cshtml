@model TanfeethIntegration.Models.RegisterViewModel


<h2 class="my-4 text-center">@ViewData["Title"]</h2>

<h4 class="text-center">إنشاء حساب جديد</h4>
<hr />
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Register" id="register-form" dir="rtl">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <div class="form-group">
                        <label asp-for="FullName" class="form-label">الاسم الكامل</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Username" class="form-label">اسم المستخدم</label>
                        <input asp-for="Username" class="form-control" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="form-group form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive" />
                        <label asp-for="IsActive" class="form-check-label" for="IsActive">نشط</label>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>
                    <div class="form-group form-check">
                        <input asp-for="IsAdmin" class="form-check-input" type="checkbox" id="IsAdmin" />
                        <label asp-for="IsAdmin" class="form-check-label" for="IsAdmin">مدير نظام</label>
                        <span asp-validation-for="IsAdmin" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <button type="button" class="btn btn-primary btn-block" onclick="confirmRegister()">تسجيل</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



<script>
    function confirmRegister() {
        swal({
            title: "هل أنت متأكد؟",
            text: "هل تريد إنشاء حساب جديد؟",
            icon: "warning",
            buttons: ["إلغاء", "تسجيل"],
            dangerMode: true,
        }).then((willRegister) => {
            if (willRegister) {
                document.getElementById('register-form').submit();
            }
        });
    }
</script>

<style>
    body {
        direction: rtl;
    }

    .card {
        margin-top: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .card-body {
        padding: 20px;
    }

    .form-label {
        margin-bottom: 5px;
    }

    .form-check {
        margin-top: 15px;
        display: flex;
        align-items: center;
        justify-content: flex-start;
    }

    .form-check-input {
        margin-right: 10px;
    }

    .form-check-label {
        margin-right: 25px;
    }
</style>
