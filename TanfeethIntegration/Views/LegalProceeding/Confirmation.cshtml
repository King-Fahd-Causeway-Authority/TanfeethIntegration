@{ Layout = "_Layout"; }
<div class="dashboard-card" style="max-width:680px;margin:70px auto 0">
<div class="dashboard-card-head"><strong>رقم الطلب</strong></div><div style="padding:30px">@if (ViewBag.ErrorMessage != null){<div class="alert alert-danger">@ViewBag.ErrorMessage</div>}else{<div class="text-center py-2"><i class="fas fa-check-circle" style="font-size:52px;color:#138a68"></i><h4 class="mt-3">تم تسجيل الطلب بنجاح</h4><p>رقم الطلب: <strong>@ViewBag.RequestNumber</strong></p></div>}<div class="text-center mt-4"><a class="btn btn-primary" href="@Url.Action("Index", "LegalProceeding")">العودة إلى تقديم الطلب</a></div></div></div>
