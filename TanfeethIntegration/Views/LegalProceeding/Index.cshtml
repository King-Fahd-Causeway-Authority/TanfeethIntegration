@model TanfeethIntegration.Models.LegalProceedingViewModel

@{
    Layout = "_Layout";
}
<link href="~/css/select2.min.css" rel="stylesheet" />






<!-- Add any stylesheets and meta tags required -->
<style>
    .rtl-layout {
        direction: rtl;
    }

        .rtl-layout .form-control,
        .rtl-layout .form-control[type="date"] {
            text-align: right;
        }

    #submit-request-header {
        color: white;
        background-color: rgb(206, 17, 38);
        border-radius: 20px;
        padding: 20px;
        display: inline-block;
        min-width: 300px;
    }

    .form-container {
        background-color: white;
        padding: 20px;
        margin: 40px auto;
        width: 1300px;
        max-width: 1300px;
       
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        border: 1px solid #ddd;
        border-radius: 8px;
    }

    .form-container {
        height: auto; /* This makes the height adjust to the content */
        /* other styles... */
    }
    #legal-representative-header {
        background-color: rgb(206, 17, 38);
        color: #ffffff;
        padding: 1rem 0.75rem;
        border-radius: 0.25rem;
        text-shadow: 1px 1px 2px #000000;
    }

    

    .btn {
        margin: 0 10px;
    }

    .section {
        position: relative; /* This ensures the .section-navigation is positioned relative to its section */
        padding-bottom: 70px; /* Add padding to the bottom of each section to make room for navigation */
    }

    .section-navigation {
        position: absolute;
        bottom: 0; /* Position the navigation at the bottom of its section */
        left: 0;
        right: 0;
        text-align: center;
        transition: transform 0.2s ease-in-out;
    }

    .btn {
        padding: 10px 30px; /* Padding for button size */
        border: none; /* No border */
        font-size: 1rem; /* Button text size */
        color: white; /* Button text color */
        border-radius: 5px; /* Rounded corners */
        cursor: pointer; /* Pointer on hover */
        transition: transform 0.2s ease-in; /* Animation for interaction */
        margin: 5px; /* Space around buttons */
    }

        .btn:hover, .btn:focus {
            outline: none; /* No focus outline */
            transform: scale(1.1); /* Scaling effect on hover/focus */
            background-color:darkcyan;
        }

    .btn-secondary {
        background-color: #6c757d; /* Example secondary color */
    }

    .btn-primary {
        background-color: rgb(206, 17, 38); /* Example primary color */
    }

    input[type="text"] {
        border-radius: 15px;
        padding: 10px;
        /* Add more styles as needed */
    }

    /* Style for EditorFor (assuming it generates a textarea) */
    textarea {
        border-radius: 15px;
        padding: 10px;
        /* Add more styles as needed */
    }
</style>
<div class="page-hero">
    <div class="page-hero-title">
        <span class="page-hero-icon"><i class="fas fa-paper-plane"></i></span>
        <div><h2>تقديم طلب تنفيذ</h2><p>أكمل بيانات الطلب على أربع مراحل ثم راجع الطلب وأرسله</p></div>
    </div>
</div>
<div class="kfca-progress" id="requestProgress" aria-label="مراحل تقديم الطلب">
    <div class="kfca-progress-step active" data-step="0"><span class="kfca-progress-icon"><i class="fas fa-file-alt"></i></span><span class="kfca-progress-copy"><strong>بيانات الطلب</strong><small>تفاصيل طلب التنفيذ</small></span></div>
    <div class="kfca-progress-step" data-step="1"><span class="kfca-progress-icon"><i class="fas fa-users"></i></span><span class="kfca-progress-copy"><strong>المنفذ ضده</strong><small>بيانات الأطراف</small></span></div>
    <div class="kfca-progress-step" data-step="2"><span class="kfca-progress-icon"><i class="fas fa-money-bill-wave"></i></span><span class="kfca-progress-copy"><strong>المطالبة</strong><small>بيانات المطالبة</small></span></div>
    <div class="kfca-progress-step" data-step="3"><span class="kfca-progress-icon"><i class="fas fa-gavel"></i></span><span class="kfca-progress-copy"><strong>السند والإرسال</strong><small>المراجعة النهائية</small></span></div>
</div>
<div class="form-container">
    <div class="rtl-layout">
        <form asp-controller="LegalProceeding" asp-action="Index" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <!-- Legal Proceeding Section -->
            <div class="section" id="legalProceedingSection">
                @Html.EditorFor(m => m.LegalProceedingRequest)
                <div class="section-navigation">
                    <button type="button" class="btn btn-primary next">التالي</button>
                <button type="button" class="btn btn-secondary back">الرجوع</button>
                </div>
            </div>

            <!-- Defendant Information Section -->
            <div class="section" id="defendantInformationSection" style="display:none;">
                <h4 id="legal-representative-header" class="text-center my-4">
                    <i class="fas fa-users"></i> بيانات المنفذ ضده
                </h4>
                <!-- Assume this select is populated with server-side logic -->
                <select id="defendantTypeId" name="DefendantTypeId" class="form-control select2">
                    <!-- Option elements here... -->
                </select>

                <div id="defendantTypeContainer">
                    <!-- Container for dynamic content based on the defendant type -->
                </div>
                <div class="section-navigation">
                    <button type="button" class="btn btn-primary next">التالي</button>
                    <button type="button" class="btn btn-secondary back">الرجوع</button>
                </div>
            </div>
            <!-- Execution Claim Section -->
            <div class="section" id="executionClaimSection" style="display:none;">
                <div class="row">
                    <div class="col-12">
                        <h4 class="text-center my-4" id="legal-representative-header" style="background-color:rgb(206, 17, 38); color: #ffffff;">
                            <i class="fas fa-file-alt"></i> بيانات المطالبة بالأداء
                        </h4>
                    </div>
                </div>              <!-- Populate this editor template with the relevant fields -->
                @Html.EditorFor(m => m.ExecutionClaimData)
                <div class="section-navigation">
                    <button type="button" class="btn btn-primary next">التالي</button>
                    <button type="button" class="btn btn-secondary back">الرجوع</button>
                </div>
            </div>

            <!-- Additional sections would continue here... -->
            <!-- Enforcement Information Section -->
            <div class="section" id="enforcementInfoSection" style="display:none;">
                <h4 id="legal-representative-header" class="text-center my-4">
                    <i class="fas fa-file-alt"></i> بيانات السند التنفيذي
                </h4>
                @Html.EditorFor(model => model.EnforcementInfo)
                <div class="section-navigation">
                    <button type="submit" class="btn btn-primary next">انشاء الطلب</button>
                    <button type="button" class="btn btn-secondary back">الرجوع</button>
                </div>
            </div>
        </form>
    </div>
</div>
