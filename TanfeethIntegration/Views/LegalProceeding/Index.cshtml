    <script type="text/javascript">
        $(document).ready(function () {
            var counter = 1;

            // Function to add a new textbox
            function addTextbox() {
                if (counter < 30) {
                    // Create new textbox element
                    var newTextBoxDiv = $('<div class="mb-2"></div>');

                    // Append the new textbox
                    newTextBoxDiv.html('<input type="text" class="form-control" name="EnforcementItems[' + counter + ']" placeholder="عنصر التنفيذ" />');
                    newTextBoxDiv.appendTo("#dynamicContainer");

                    counter++;
                }
            }

            // Attach click event to the button
            $("#addTextbox").click(function () {
                console.log("Button clicked, adding a textbox.");
                addTextbox();
            });
            var updateDefendantTypeView = function (defendantTypeId) {
               

                // Use AJAX to get the partial view from the server
                $.ajax({
                    url: '@Url.Action("GetDefendantTypePartialView", "LegalProceeding")', // Make sure the URL is correct for your application
                    data: { defendantTypeId: defendantTypeId },
                    success: function (response) {
                        $('#defendantTypeContainer').html(response);

                    },
                    error: function (xhr, status, error) {
                        // console.error('Error:', error);
                        // console.error('Status:', status);
                        // console.error('Response:', xhr.responseText);
                    }
                });
            };

            var populateDefendantTypesDropdown = function () {
                $.ajax({
                    url: '@Url.Action("GetDefendantTypes", "Lookup")',
                    success: function (data) {
                        // console.log("Received data as JSON string:", JSON.stringify(data));

                        var $defendantTypeDropdown = $('#defendantTypeId');
                        $defendantTypeDropdown.empty();
                        // Inside the success callback of populateDefendantTypesDropdown
                        $.each(data, function (index, item) {
                            var optionElement = $('<option></option>').val(item.id).text(item.nameAr);

                            // Optional: setting Disabled and Selected if coming from server-side
                            if (item.Disabled) {
                                optionElement.prop('disabled', true);
                            }
                            if (item.Selected) {
                                optionElement.prop('selected', true);
                            }

                            $defendantTypeDropdown.append(optionElement);
                        });
                    },
                    error: function (xhr, status, error) {
                        console.error('Error fetching defendant types:', status, error);
                    }
                });
            };
            $('#defendantTypeId').change(function () {

                var typeId = $(this).val();
                

                updateDefendantTypeView(typeId);
            });

            populateDefendantTypesDropdown();

            $('form').on('submit', function (e) {
                // e.preventDefault(); // Only when debugging.
                var serializedData = $(this).serialize();
                e.currentTarget.submit(); // Submit the form programmatically when not debugging anymore.
                console.log(serializedData);

            });


        });

      
    </script>


