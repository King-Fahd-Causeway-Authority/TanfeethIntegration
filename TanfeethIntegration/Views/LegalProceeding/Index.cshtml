@section Scripts {

    

    <!-- Validation scripts -->


    <script src="~/js/select2.min.js"></script>
<script type="text/javascript">
        $(document).ready(function () {
            
            var currentSectionIndex = 0;
            var sections = $('.section');
            var form = $('form');

            function showSection(index) {
                sections.hide().eq(index).show();
                $('#requestProgress .kfca-progress-step').each(function () {
                    var step = Number($(this).data('step'));
                    $(this).toggleClass('active', step === index);
                    $(this).toggleClass('completed', step < index);
                });
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            function isSectionValid(index) {
                var currentSection = sections.eq(index);
                // Trigger jQuery Validate on the current section's inputs.
                var valid = true;

                // Only validate the inputs of the current section
                currentSection.find(':input').each(function () {
                    if (!$(this).valid()) {
                        valid = false;
                    }
                });

                if (valid) {
                    currentSection.find('.field-validation-error').removeClass('field-validation-error');
                }

                return valid;
            }

            $('.next').click(function () {
                if (isSectionValid(currentSectionIndex)) {
                    currentSectionIndex++;
                    showSection(currentSectionIndex);
                } else {
                    // Optionally scroll to the first error
                    var firstError = sections.eq(currentSectionIndex).find('.field-validation-error').first();
                    if (firstError.length > 0) {
                        $('html, body').animate({
                            scrollTop: firstError.offset().top - 20
                        }, 300);
                    }
                }
            });

            $('.back').click(function () {
                if (currentSectionIndex > 0) {
                    currentSectionIndex--;
                    showSection(currentSectionIndex);
                }
            });

            // Show the initial section
            showSection(currentSectionIndex);
           
                        $('form .form-control').each(function () {
                            var messages = [];
                            var element = $(this);
                            $.each(element.data(), function (key, val) {
                                if (key.indexOf("val") === 0 && key !== 'val') { // Check if the key starts with 'val'
                                    messages.push(val);
                                }
                            });
                            if (messages.length > 0) {
                                element.attr('title', messages.join("\n"));
                            }
                        });

                        // Bind the keyup and focusout events to perform validation and update tooltips
                        $('form .form-control').on('keyup focusout', function () {
                            var element = $(this);
                            var isValid = element.valid();
                            var messages = [];

                            // If the field isn't valid, find all generated error messages and update the tooltip
                            if (!isValid) {
                                var name = element.attr('name');
                                var container = $('span[data-valmsg-for="' + name + '"]');
                                var errors = container.find('li, span');
                                errors.each(function () {
                                    messages.push($(this).text());
                                });
                                element.attr('title', messages.join("\n"));
                            } else {
                                element.attr('title', ""); // Clear the tooltip if valid
                            }
                        });
                        //$.validator.unobtrusive.parse("#LicenseNumber");
                        $(document).on('keypress', '#LicenseNumber', function (e) {
                            var keyCode = e.which;

                            //1. Allow: backspace, delete, tab, escape, and enter
                            //2. Allow: Ctrl+A, Ctrl+C, Ctrl+V, Command+A
                            //3. Allow: home, end, left, right, up, down
                            //4. Allow only English letters and numbers, no spaces
                            if (keyCode === 8 || keyCode === 9 || keyCode === 27 || keyCode === 13 ||
                                (keyCode === 65 && e.ctrlKey === true) ||
                                (keyCode === 67 && e.ctrlKey === true) ||
                                (keyCode === 86 && e.ctrlKey === true) ||
                                (keyCode === 65 && e.metaKey === true) ||
                                (keyCode >= 35 && keyCode <= 40)) {
                                // let it happen, don't do anything
                                return;
                            } else {
                                if ((e.shiftKey || (keyCode < 48 || keyCode > 57)) && (keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 122)) {
                                    // Ensure that it is a number or an English letter and stop the keypress
                                    e.preventDefault();
                                }
                            }
                        });
                    });

    </script>
