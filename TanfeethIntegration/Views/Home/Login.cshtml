@model TanfeethIntegration.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0" />
    <title>تسجيل الدخول - منصة الربط مع تنفيذ</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/kfca-icons.css" />
    <style>
        *{box-sizing:border-box}html,body{margin:0;min-height:100%}body{min-height:100vh;display:grid;place-items:center;background:radial-gradient(circle at 20% 20%,rgba(123,63,242,.42),transparent 35%),linear-gradient(135deg,#17105c,#2d1b78 45%,#5b2fd3);padding:20px;font-family:Tahoma,"Segoe UI",Arial,sans-serif;color:#1A0C5F}
        .login-card{width:min(100%,470px);background:#fff;border:1px solid rgba(255,255,255,.2);border-radius:24px;box-shadow:0 30px 75px rgba(11,6,55,.30);padding:34px}
        .login-logo{display:block;max-width:310px;width:76%;height:auto;margin:0 auto 24px}.login-title{text-align:center;font-size:25px;font-weight:800;margin-bottom:5px}.login-sub{text-align:center;color:#77758c;font-size:13px;margin-bottom:28px}
        .form-group{margin-bottom:20px}.form-group label{display:block;margin-bottom:8px;font-size:15px;font-weight:700}.form-control{height:58px;border:1px solid #d4e2e8;border-radius:13px;background:#fbfcfd;padding:12px 15px;color:#1A0C5F}.form-control:focus{border-color:#5E50A2;box-shadow:0 0 0 4px rgba(94,80,162,.10)}
        .remember-row{margin:0 0 22px}.form-check-input:checked{background-color:#5E50A2;border-color:#5E50A2}.login-btn{width:100%;min-height:60px;border:0;border-radius:13px;color:#fff;background:linear-gradient(100deg,#39208f,#5e31c8 55%,#7137e7);font-size:17px;font-weight:700;box-shadow:0 10px 22px rgba(80,44,180,.25);display:flex;gap:8px;align-items:center;justify-content:center}.login-btn:hover{filter:brightness(1.04);transform:translateY(-1px)}.validation-summary-errors{border:1px solid rgba(206,40,47,.18);border-radius:10px;background:rgba(206,40,47,.06);padding:10px 13px;margin-bottom:18px}.text-danger{font-size:12px}
        @media(max-width:576px){.login-card{padding:28px 22px}.login-logo{width:84%}}
    </style>
</head>
<body>
    <div class="login-card">
        <img src="~/Images/Log.jpg" alt="المؤسسة العامة لجسر الملك فهد" class="login-logo" />
        <div class="login-title">منصة الربط مع تنفيذ</div>
        <div class="login-sub">أدخل بيانات حساب الدومين للوصول إلى المنصة</div>
        <form asp-action="Login" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Username">اسم المستخدم</label>
                <input asp-for="Username" class="form-control" dir="ltr" autocomplete="username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password">كلمة المرور</label>
                <input asp-for="Password" class="form-control" dir="ltr" type="password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="remember-row form-check form-switch">
                <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                <label asp-for="RememberMe" class="form-check-label" for="rememberMe">تذكرني</label>
            </div>
            <button type="submit" class="login-btn"><i class="fas fa-check"></i> تسجيل الدخول</button>
        </form>
    </div>
    <script src="~/lib/jquery/dist/jquery-3.7.1.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
